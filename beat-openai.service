# Example user service for the default install.sh launcher.
# Prefer `beat service install` or `beat service enable`: those commands generate
# a unit with the actual installation paths and preserve the user's environment.
# Install this template under ~/.config/systemd/user/, never as a root service.
[Unit]
Description=BeAT OpenAI-compatible gateway
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/beat service run
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
